    "id": 3, "variant": "text", "align": "center",
    "input": {},
    "expected": {},
    "css": ".rebnr-text.rebnr-text-3{display:block;width:100%;max-width:none;text-align:center}.rebnr-text.rebnr-text-3 p,.rebnr-text.rebnr-text-3 h1,.rebnr-text.rebnr-text-3 h2,.rebnr-text.rebnr-text-3 h3,.rebnr-text.rebnr-text-3 h4,.rebnr-text.rebnr-text-3 h5,.rebnr-text.rebnr-text-3 h6,.rebnr-text.rebnr-text-3 li{text-align:center}"
  },
  {
    "label": "text variant: a heading override names the block itself, list items and links stay descendants",
    "id": 5, "variant": "text",
    "input": { "h2": { "font_size": 40, "text_transform": "uppercase" }, "li": { "font_size": 14 }, "a": { "text_decoration": "none" } },
    "expected": { "h2": { "font_size": 40, "text_transform": "uppercase" }, "li": { "font_size": 14 }, "a": { "text_decoration": "none" } },
    "css": "h2.rebnr-text.rebnr-text-5,.rebnr-text.rebnr-text-5 h2{font-size:40px;text-transform:uppercase}.rebnr-text.rebnr-text-5 li{font-size:14px}.rebnr-text.rebnr-text-5 a{text-decoration:none}"
  },
  {
    "label": "text layout align: an explicit wrapper max width is emitted after the layout rule and wins",
    "id": 4, "variant": "text", "align": "right",
    "input": { "container": { "max_width": 600 } },
    "expected": { "container": { "max_width": 600 } },
    "css": ".rebnr-text.rebnr-text-4{display:block;width:100%;max-width:none;text-align:right}.rebnr-text.rebnr-text-4 p,.rebnr-text.rebnr-text-4 h1,.rebnr-text.rebnr-text-4 h2,.rebnr-text.rebnr-text-4 h3,.rebnr-text.rebnr-text-4 h4,.rebnr-text.rebnr-text-4 h5,.rebnr-text.rebnr-text-4 h6,.rebnr-text.rebnr-text-4 li{text-align:right}.rebnr-text.rebnr-text-4{max-width:600px}"
  },
  {
